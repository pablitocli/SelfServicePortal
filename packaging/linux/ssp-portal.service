# Self-Service Portal - systemd unit (installed to /etc/systemd/system by packaging/linux/install.sh).
# Local overrides: systemctl edit ssp-portal.service   (do not edit this file in place).
[Unit]
Description=Self-Service Portal (PowerShell / Pode web portal)
Documentation=file:///opt/ssp/docs/installation-linux.md
After=network-online.target ssp-firstboot.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ssp
Group=ssp
WorkingDirectory=/opt/ssp
EnvironmentFile=/etc/ssp/portal.env
Environment=POWERSHELL_TELEMETRY_OPTOUT=1
Environment=POWERSHELL_UPDATECHECK=Off
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
ExecStart=/usr/bin/pwsh -NoProfile -NonInteractive -File /opt/ssp/Start-Portal.ps1
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
SyslogIdentifier=ssp-portal
UMask=0027
LimitNOFILE=65536

# Bind 443 without root. Child pwsh job processes inherit only this capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. MemoryDenyWriteExecute and SystemCallFilter are intentionally NOT used: the .NET JIT
# needs W+X memory and the portal spawns child pwsh processes for jobs.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/ssp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# AF_NETLINK: .NET enumerates network interfaces through netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
