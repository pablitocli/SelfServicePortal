{
  "$schema": "../schema/catalog-item.schema.json",
  "id": "blueprint-three-tier",
  "version": "1.0.0",
  "enabled": true,
  "name": "Three-tier application (WEB / APP / DB)",
  "category": "Blueprints",
  "icon": "vm",
  "summary": "Deploy a Windows web, application and database VM in one request, ready for the application team.",
  "description": "Creates <AppCode>WEB01 and <AppCode>APP01 on the selected workload cluster and <AppCode>DB01 on the database cluster (same datastore), keeps WEB and APP on different hosts (DRS anti-affinity), installs the software baseline, assigns the backup policy and optionally installs SQL Server on the DB VM (with data, log, backup and tempdb disks). Every step is reported; on failure everything created by the request is removed.",
  "owner": "Infrastructure Operations",
  "tags": [
    "vSphere",
    "Windows",
    "Blueprint",
    "SQL Server",
    "Three-tier"
  ],
  "estimatedDuration": "90-180 min",
  "access": {
    "roles": [
      "Requester",
      "Approver",
      "Admin"
    ],
    "teams": [
      "@datacenter"
    ]
  },
  "approval": {
    "required": true,
    "approverRoles": [
      "Approver",
      "Admin"
    ]
  },
  "execution": {
    "handler": "New-VsphereThreeTierApp.ps1",
    "requiresVCenter": true,
    "siteInput": "Site",
    "timeoutMinutes": 240,
    "fixedParameters": {
      "Template": "@site:windowsTemplate",
      "CustomizationSpec": "@site:windowsCustomizationSpec",
      "SqlInstallerPath": "@site:sqlServerMediaPath",
      "SqlDiskSizesGB": "100,50,100,50"
    }
  },
  "inputs": [
    {
      "name": "AppCode",
      "label": "Application code",
      "type": "text",
      "group": "General",
      "required": true,
      "transform": "upper",
      "placeholder": "CRM",
      "help": "VM names: <code>WEB01, <code>APP01, <code>DB01 (max 15 characters).",
      "validation": {
        "pattern": "^[A-Za-z0-9]{2,8}$",
        "patternMessage": "2-8 letters or digits."
      }
    },
    {
      "name": "Site",
      "label": "Datacenter",
      "type": "select",
      "group": "Placement",
      "required": true,
      "source": {
        "type": "sites"
      }
    },
    {
      "name": "Workload",
      "label": "Workload cluster (WEB / APP tier)",
      "type": "select",
      "group": "Placement",
      "required": true,
      "default": "App",
      "help": "Cluster for the web/app tier. The DB VM always goes to the database cluster.",
      "options": [
        {
          "value": "App",
          "label": "Application (APP cluster)"
        },
        {
          "value": "DB",
          "label": "Database (DB cluster)"
        }
      ]
    },
    {
      "name": "Datastore",
      "label": "Datastore",
      "type": "select",
      "group": "Placement",
      "required": true,
      "help": "Used by the three VMs: it must also be mounted on the DB cluster (checked before anything is created).",
      "source": {
        "type": "datastores",
        "dependsOn": [
          "Site",
          "Workload"
        ],
        "minFreeGB": 500
      }
    },
    {
      "name": "Folder",
      "label": "VM folder",
      "type": "select",
      "group": "Placement",
      "required": true,
      "source": {
        "type": "folders",
        "dependsOn": [
          "Site"
        ]
      }
    },
    {
      "name": "Size",
      "label": "Size",
      "type": "select",
      "group": "Sizing",
      "required": true,
      "default": "Medium",
      "help": "WEB and APP get this size; the DB VM gets the same vCPU and double memory.",
      "options": [
        {
          "value": "Small",
          "label": "Small - 2 vCPU / 4 GB (DB 8 GB)"
        },
        {
          "value": "Medium",
          "label": "Medium - 4 vCPU / 8 GB (DB 16 GB)"
        },
        {
          "value": "Large",
          "label": "Large - 8 vCPU / 16 GB (DB 32 GB)"
        }
      ]
    },
    {
      "name": "PortGroup",
      "label": "Network (port group)",
      "type": "select",
      "group": "Network",
      "required": true,
      "source": {
        "type": "portgroups",
        "dependsOn": [
          "Site"
        ]
      }
    },
    {
      "name": "IpWeb",
      "label": "WEB IP address",
      "type": "ipv4",
      "group": "Network",
      "required": true
    },
    {
      "name": "IpApp",
      "label": "APP IP address",
      "type": "ipv4",
      "group": "Network",
      "required": true
    },
    {
      "name": "IpDb",
      "label": "DB IP address",
      "type": "ipv4",
      "group": "Network",
      "required": true
    },
    {
      "name": "SubnetMask",
      "label": "Subnet mask",
      "type": "ipv4",
      "group": "Network",
      "required": true,
      "default": "255.255.254.0"
    },
    {
      "name": "Gateway",
      "label": "Default gateway",
      "type": "ipv4",
      "group": "Network",
      "required": true
    },
    {
      "name": "DnsServers",
      "label": "DNS servers (comma separated)",
      "type": "text",
      "group": "Network",
      "required": false,
      "help": "Leave empty to use the site defaults.",
      "validation": {
        "pattern": "^\\s*$|^(\\d{1,3}(\\.\\d{1,3}){3})(\\s*,\\s*\\d{1,3}(\\.\\d{1,3}){3})*$",
        "patternMessage": "Comma separated IPv4 list."
      }
    },
    {
      "name": "GuestCredential",
      "label": "Guest administrator credential",
      "type": "credential",
      "group": "Software",
      "required": true,
      "vaultTags": [
        "guest-windows"
      ],
      "help": "Used inside the VMs for the software baseline and SQL Server setup."
    },
    {
      "name": "BaselineSet",
      "label": "Software baseline",
      "type": "select",
      "group": "Software",
      "required": true,
      "source": {
        "type": "softwareSets",
        "os": "windows"
      }
    },
    {
      "name": "BackupPolicy",
      "label": "Backup policy",
      "type": "select",
      "group": "Software",
      "required": true,
      "source": {
        "type": "backupPolicies"
      }
    },
    {
      "name": "InstallSql",
      "label": "Install SQL Server on the DB VM",
      "type": "boolean",
      "group": "Database",
      "default": true,
      "help": "Adds data, log, backup and tempdb disks to the DB VM and installs SQL Server 2022."
    },
    {
      "name": "SysAdminGroup",
      "label": "SQL sysadmin group (DOMAIN\\group)",
      "type": "text",
      "group": "Database",
      "required": true,
      "visibleWhen": {
        "field": "InstallSql",
        "equals": true
      },
      "validation": {
        "pattern": "^[A-Za-z0-9._-]+\\\\[^\\\\/:*?\"<>|]+$",
        "patternMessage": "DOMAIN\\group"
      }
    },
    {
      "name": "Owner",
      "label": "Technical owner (email)",
      "type": "text",
      "group": "Governance",
      "required": true,
      "validation": {
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "patternMessage": "Valid email address required."
      }
    },
    {
      "name": "CostCenter",
      "label": "Cost center",
      "type": "text",
      "group": "Governance",
      "required": true,
      "validation": {
        "maxLength": 20
      }
    },
    {
      "name": "ChangeTicket",
      "label": "Change ticket",
      "type": "text",
      "group": "Governance",
      "required": false,
      "validation": {
        "maxLength": 30
      }
    }
  ]
}
