{
  "$schema": "../schema/catalog-item.schema.json",
  "id": "cloud-azure-windows-2025",
  "version": "1.0.0",
  "enabled": true,
  "name": "Azure VM - Windows Server 2025",
  "category": "Cloud Ops",
  "icon": "cloud",
  "summary": "Deploy an Azure VM with Windows Server 2025 in the Azure VNet.",
  "description": "Deploys an Azure VM from the Windows Server 2025 Datacenter Azure Edition marketplace image into a subnet of the configured VNet, with Premium SSD disks and mandatory cost/ownership tags. The local admin password is generated and stored in Key Vault.",
  "owner": "Cloud Operations",
  "tags": [
    "Azure",
    "Windows",
    "Windows Server 2025"
  ],
  "estimatedDuration": "8-15 min",
  "access": {
    "roles": [
      "Requester",
      "Approver",
      "Admin"
    ],
    "teams": [
      "@cloud"
    ]
  },
  "approval": {
    "required": true,
    "approverRoles": [
      "Approver",
      "Admin"
    ]
  },
  "execution": {
    "handler": "New-AzureVm.ps1",
    "requiresVCenter": false,
    "cloud": "azure",
    "timeoutMinutes": 45,
    "fixedParameters": {
      "OsFlavor": "Windows2025"
    }
  },
  "inputs": [
    {
      "name": "VmName",
      "label": "VM name",
      "type": "text",
      "group": "General",
      "required": true,
      "transform": "upper",
      "validation": {
        "pattern": "^[A-Za-z][A-Za-z0-9-]{2,14}$",
        "patternMessage": "3-15 characters, start with a letter; letters, digits and hyphens."
      }
    },
    {
      "name": "Description",
      "label": "Purpose / description",
      "type": "textarea",
      "group": "General",
      "required": true,
      "validation": {
        "maxLength": 250
      }
    },
    {
      "name": "VmSize",
      "label": "VM size",
      "type": "select",
      "group": "Sizing",
      "required": true,
      "source": {
        "type": "azureVmSizes"
      }
    },
    {
      "name": "DataDiskGB",
      "label": "Additional data disk (GB)",
      "type": "number",
      "group": "Sizing",
      "default": 0,
      "help": "0 = none. Premium SSD.",
      "validation": {
        "min": 0,
        "max": 32767
      }
    },
    {
      "name": "Subnet",
      "label": "Subnet (VNet)",
      "type": "select",
      "group": "Network",
      "required": true,
      "source": {
        "type": "azureSubnets"
      }
    },
    {
      "name": "PublicIp",
      "label": "Assign a public IP",
      "type": "boolean",
      "group": "Network",
      "default": false
    },
    {
      "name": "Owner",
      "label": "Technical owner (email)",
      "type": "text",
      "group": "Governance",
      "required": true,
      "validation": {
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "patternMessage": "Valid email address required."
      }
    },
    {
      "name": "CostCenter",
      "label": "Cost center",
      "type": "text",
      "group": "Governance",
      "required": true,
      "validation": {
        "maxLength": 20
      }
    },
    {
      "name": "ChangeTicket",
      "label": "Change ticket",
      "type": "text",
      "group": "Governance",
      "required": false,
      "validation": {
        "maxLength": 30
      }
    }
  ],
  "vmNotes": true
}
