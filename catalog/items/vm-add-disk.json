{
  "$schema": "../schema/catalog-item.schema.json",
  "id": "vm-add-disk",
  "version": "1.0.0",
  "enabled": true,
  "name": "Add disk to VM",
  "category": "Datacenter operations",
  "icon": "storage",
  "summary": "Hot-add a thin-provisioned data disk to an existing VM.",
  "description": "Adds a virtual disk on the VM's datastore, respecting the site free-space floor. The guest OS must bring the disk online.",
  "owner": "Infrastructure Operations",
  "tags": [
    "vSphere",
    "Day 2",
    "Storage"
  ],
  "estimatedDuration": "2-5 min",
  "access": {
    "roles": [
      "Requester",
      "Approver",
      "Admin"
    ],
    "teams": [
      "@datacenter"
    ]
  },
  "approval": {
    "required": true,
    "approverRoles": [
      "Approver",
      "Admin"
    ]
  },
  "execution": {
    "handler": "Add-VsphereVmDisk.ps1",
    "requiresVCenter": true,
    "siteInput": "Site",
    "timeoutMinutes": 30,
    "fixedParameters": {}
  },
  "inputs": [
    {
      "name": "Site",
      "label": "Datacenter",
      "type": "select",
      "group": "Target",
      "required": true,
      "source": {
        "type": "sites"
      }
    },
    {
      "name": "VMName",
      "label": "Virtual machine",
      "type": "select",
      "group": "Target",
      "required": true,
      "source": {
        "type": "vms",
        "dependsOn": [
          "Site"
        ]
      }
    },
    {
      "name": "SizeGB",
      "label": "Disk size (GB)",
      "type": "number",
      "group": "Disk",
      "required": true,
      "default": 50,
      "validation": {
        "min": 1,
        "max": 4096
      }
    },
    {
      "name": "Format",
      "label": "Provisioning",
      "type": "select",
      "group": "Disk",
      "required": true,
      "default": "Thin",
      "options": [
        {
          "value": "Thin",
          "label": "Thin"
        },
        {
          "value": "Thick",
          "label": "Thick (lazy zeroed)"
        }
      ]
    },
    {
      "name": "ChangeTicket",
      "label": "Change ticket",
      "type": "text",
      "group": "Change",
      "required": false,
      "validation": {
        "maxLength": 30
      }
    }
  ]
}
